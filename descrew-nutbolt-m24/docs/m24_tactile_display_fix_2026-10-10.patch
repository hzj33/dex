+DEFAULT_FORCE_MAX_N = 10.0
+DEFAULT_NOISE_FLOOR_N = 0.2
+DEFAULT_ARROW_MIN_N = 0.02
+DEFAULT_ARROW_SCALE_N = 1.0
+
+
+def validate_display_settings(force_max, layout, noise_floor, arrow_min, arrow_scale):
+    if layout not in ('fingertips', 'full'):
+        raise ValueError('layout must be fingertips or full')
+    for name, value in (('force_max', force_max), ('noise_floor', noise_floor),
+                        ('arrow_min', arrow_min), ('arrow_scale', arrow_scale)):
+        if not math.isfinite(value) or value < 0 or (name != 'noise_floor' and value == 0):
+            raise ValueError(f'{name} 必须有限，噪声阈值非负，其他量程/门槛为正')
+
+
+def add_display_arguments(parser):
+    parser.add_argument('--force-max-n', type=float, default=DEFAULT_FORCE_MAX_N, help='颜色量程上限，默认10 N')
+    parser.add_argument('--layout', choices=('fingertips', 'full'), default='fingertips')
+    parser.add_argument('--noise-floor-n', type=float, default=DEFAULT_NOISE_FLOOR_N, help='总力小读数过滤，默认0.2 N')
+    parser.add_argument('--arrow-min-n', type=float, default=DEFAULT_ARROW_MIN_N, help='切向箭头门槛，默认0.02 N')
+    parser.add_argument('--arrow-scale-n', type=float, default=DEFAULT_ARROW_SCALE_N, help='箭长独立满量程，默认1 N')
+
+
+def display_options(args):
+    validate_display_settings(args.force_max_n, args.layout, args.noise_floor_n, args.arrow_min_n, args.arrow_scale_n)
+    return dict(layout=args.layout, noise_floor=args.noise_floor_n,
+                arrow_min=args.arrow_min_n, arrow_scale=args.arrow_scale_n)
+
