+        print('[tactile-zero] 校零开始；请保持触觉面无接触。', flush=True)
+        calibration = self.tactile_calibration
+        calibration['calls'] += 1
+        calibration['started_at'] = utc_now()
+        try:
+            calibration['returned_success'] = bool(self.control.calibrateSensor())
+            if not calibration['returned_success']:
+                raise RuntimeError('DexH13 SDK calibrateSensor failed; deployment aborted')
+            calibration['status'] = 'settling'
+            time.sleep(calibration['wait_seconds'])
+            calibration['status'] = 'completed'
+            calibration['ended_at'] = utc_now()
+        except BaseException as exc:
+            calibration['status'] = 'interrupted' if isinstance(exc, KeyboardInterrupt) else 'failed'
+            calibration['error'] = str(exc)
+            calibration['ended_at'] = utc_now()
+            raise
+        print('[tactile-zero] 校零成功，继续原部署。', flush=True)
