+    entry=("$tactile_script" --deploy-script "$bundle_dir/deploy_m24_e003_student.py"
+        --hz "${DEXH13_TACTILE_HZ:-10}" --force-max-n "${DEXH13_TACTILE_MAX_N:-1}" --)
+fi
 echo "回位进度修正持续部署：Ctrl+C结束。"
