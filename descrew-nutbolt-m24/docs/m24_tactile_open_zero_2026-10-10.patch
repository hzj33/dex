+# Display-only open-pose gate; initial angles require checking on the hardware.
+OPEN_INDEX_DEG = float(os.environ.get('DEXH13_TACTILE_OPEN_INDEX_DEG', '50'))
+OPEN_THUMB_DEG = float(os.environ.get('DEXH13_TACTILE_OPEN_THUMB_DEG', '28'))
+OPEN_HYSTERESIS_DEG = 2.0
+OPEN_FEEDBACK_MAX_AGE = 0.25
+if not all(math.isfinite(v) and 0 <= v <= 90 for v in (OPEN_INDEX_DEG, OPEN_THUMB_DEG)):
+    raise ValueError('Tactile open-pose thresholds must be finite degrees in [0,90]')
+
+
+class OpenPoseDisplayGate:
+    """Suppress three-finger display only while both measured opening joints are low."""
+    def __init__(self):
+        self.opened = False
+
+    def evaluate(self, feedback, captured):
+        if feedback is None or not 0 <= captured - feedback[1] <= OPEN_FEEDBACK_MAX_AGE:
+            self.opened = False
+            return ()
+        q, _ = feedback
+        if len(q) != 16 or not all(math.isfinite(float(v)) for v in q):
+            self.opened = False
+            return ()
+        margin = OPEN_HYSTERESIS_DEG if self.opened else 0.0
+        self.opened = (math.degrees(float(q[1])) <= OPEN_INDEX_DEG + margin and
+                       math.degrees(float(q[14])) <= OPEN_THUMB_DEG + margin)
+        return ('index', 'middle', 'thumb') if self.opened else ()
+
